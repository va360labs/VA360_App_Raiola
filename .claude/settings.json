{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Edit(./.env)",
      "Edit(**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env.js\"",
            "statusMessage": "Comprobando acceso a .env"
          }
        ]
      }
    ]
  }
}
