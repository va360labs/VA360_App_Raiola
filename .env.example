# Copia este archivo como .env y rellena los valores. Nunca subas el .env a GitHub.

# Obligatorias
ANTHROPIC_API_KEY=
ADMIN_PASSWORD=

# Opcionales
# Modelo de Claude para redactar las respuestas (por defecto claude-sonnet-5-5)
ANTHROPIC_MODEL=
# Carpeta de datos: base de datos, documentos y secretos generados (por defecto ./data; en Docker /data)
DATA_DIR=
# Zona horaria para mostrar fechas en el panel (por defecto Europe/Madrid)
APP_TIMEZONE=
# Si se dejan vacías, la aplicación las genera una vez y las guarda en la carpeta de datos
SESSION_SECRET=
WHATSAPP_VERIFY_TOKEN=
EMAIL_WEBHOOK_TOKEN=
# Secreto de la app de Meta para verificar la firma de los webhooks de WhatsApp
WHATSAPP_APP_SECRET=
