# Copia este archivo como .env y rellena los valores. Nunca subas el .env a GitHub.

# Obligatorias
ANTHROPIC_API_KEY=
ADMIN_PASSWORD=

# Opcionales
# Modelo de Claude para redactar las respuestas (por defecto claude-opus-5-5)
ANTHROPIC_MODEL=
# Carpeta de datos: base de datos, documentos y secretos generados (por defecto ./data; en Docker /data)
DATA_DIR=
# Para pruebas sin llamar a Claude: DRAFT_MODEL=fake
DRAFT_MODEL=
# Zona horaria para mostrar fechas en el panel (por defecto Europe/Madrid)
APP_TIMEZONE=
# En el primer arranque se cargan los documentos de la clínica de ejemplo; false para empezar vacía
DEMO_DATOS=
# Dirección con la que el servidor se llama a sí mismo desde el simulador (por defecto, su propio puerto)
INTERNAL_BASE_URL=
# Si se dejan vacías, la aplicación las genera una vez y las guarda en la carpeta de datos
SESSION_SECRET=
WHATSAPP_VERIFY_TOKEN=
EMAIL_WEBHOOK_TOKEN=
# Secreto de la app de Meta para verificar la firma de los webhooks de WhatsApp
WHATSAPP_APP_SECRET=
